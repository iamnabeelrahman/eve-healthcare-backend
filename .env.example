NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://eve:eve_password@localhost:5432/eve_healthcare?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRATION=1d

# Webhook
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Logging
LOG_LEVEL=info

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=100
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Payment simulation
# Set to "success" or "failure" to force deterministic outcomes in tests/dev
PAYMENT_SIMULATION_MODE=random